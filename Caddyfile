# global options
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

(backend_upstream) {
	dynamic a {
		name {$BACKEND_DOMAIN:backend.railway.internal}
		port {$BACKEND_PORT:8080}
		refresh 5s
		dial_timeout 3s
		versions ipv4 ipv6
	}
}

(frontend_upstream) {
	dynamic a {
		name {$FRONTEND_DOMAIN:frontend.railway.internal}
		port {$FRONTEND_PORT:3000}
		refresh 5s
		dial_timeout 3s
		versions ipv4 ipv6
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 5
	lb_try_duration 5s
	lb_try_interval 500ms
}

(passive_health_checks) {
	fail_duration 10s
	max_fails 300
	unhealthy_latency 30s
	unhealthy_request_count 300
}

(proxy_headers) {
	header_up Host {upstream_hostport}
	header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
}

:{$PORT} {
	log {
		format json
	}

	encode gzip zstd

	# ACTUATOR
	handle /actuator* {
		reverse_proxy {
			import backend_upstream
			import lb_settings
			import passive_health_checks
			import proxy_headers
		}
	}

	# BACKEND API
	handle /api/* {
		reverse_proxy {
			import backend_upstream
			import lb_settings
			import passive_health_checks
			import proxy_headers
		}
	}

	# FRONTEND
	handle {
		# La CSP, X-Frame-Options, X-Content-Type-Options y Referrer-Policy las
		# pone ahora Cloudflare, en cloudflare/csp.tf de beel-infra (fase
		# http_response_headers_transform). Ahí y en ningún otro sitio.
		#
		# El motivo es que la consola se sirve desde dos infraestructuras
		# —app.beel.es por aquí, test.beel.es por un túnel a Dokploy— y este
		# Caddy solo está delante de una. Mantener la política en cada origen
		# la duplicaba en dos tecnologías distintas, y ya había divergido:
		# test.beel.es no servía CSP ninguna.
		#
		# Lo que queda aquí es lo que el borde NO puede dar: `-Server` se
		# aplica donde se genera la cabecera, y Permissions-Policy no está en
		# la regla de Cloudflare. X-XSS-Protection sigue por no mezclar su
		# retirada —está obsoleta— con este cambio.
		header {
			X-XSS-Protection "1; mode=block"
			Permissions-Policy "geolocation=(), microphone=(), camera=()"
			-Server
		}

		reverse_proxy {
			import frontend_upstream
			import lb_settings
			import passive_health_checks
			import proxy_headers
		}
	}
}
